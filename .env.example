# OpenRouter API key (required for the agent to call DeepSeek)
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx
# Firecrawl key (optional; only needed for live scraping / Phase 2 fallback)
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxx
# Override DB password used by docker-compose (defaults match config.toml)
POSTGRES_PASSWORD=partselect
